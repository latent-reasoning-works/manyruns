/* The roster's layout — declared here, not as literals in a widget.

   `shell.render_result` hardcodes `width=30` for its steps
   column, and a real render splits `ndarray(18…` / `10) float32` across lines because of it.
   The rule that replaces it: nothing in this file states a width in cells. Every size is
   relative (`1fr`, `auto`, `100%`), so the panes are a constraint the layout engine solves at
   whatever size the terminal happens to be. The one measurement that is unavoidable — which
   COLUMNS fit — is made against the real strings at the real width in `roster.columns_that_fit`,
   because CSS cannot know how long a dataset's name is. */

Screen {
    layout: vertical;
}

#title {
    padding: 1 2 0 2;
}

#footnote {
    padding: 0 2 1 3;
    color: $text-muted;
}

/* the "choose your data" panel: its title and subtitle are the border's, set in on_mount */
#roster-body {
    border: round $primary;
    border-title-align: left;
    border-subtitle-align: center;
    margin: 0 1 1 1;
    height: 1fr;
    width: 100%;
}

#roster {
    height: 1fr;
    width: 100%;
    scrollbar-size-vertical: 1;
}

/* The cursor row. Styled the same focused or blurred: focus lives in the filter box so the
   table is always blurred, and the default blurred cursor is a shade of grey that does not
   answer "which row does enter act on". The `▸` in the mark column is the real answer; this
   just keeps the row from disappearing under it. */
#roster > .datatable--cursor {
    background: $primary 30%;
    color: $text;
}

#roster > .datatable--header {
    background: transparent;
    color: $text-muted;
    text-style: none;
}

/* the filter sits inside the panel, borderless, so it reads as the panel's own prompt line */
#filter {
    border: none;
    background: transparent;
    height: auto;
    padding: 0 1;
    width: 100%;
}

#pending {
    padding: 2 3;
}
